{
  "version": 1,
  "author": "Energy Monitor",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-potentiometer", "id": "load", "top": -110, "left": 180, "attrs": {} },
    { "type": "wokwi-slide-switch", "id": "shower", "top": 40, "left": 220, "attrs": {} },
    { "type": "wokwi-pushbutton", "id": "drop", "top": 140, "left": 210, "attrs": { "color": "red" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "load:VCC", "esp:3V3", "red", [] ],
    [ "load:GND", "esp:GND.1", "black", [] ],
    [ "load:SIG", "esp:34", "green", [] ],
    [ "shower:2", "esp:27", "blue", [] ],
    [ "shower:3", "esp:GND.2", "black", [] ],
    [ "drop:1.l", "esp:26", "orange", [] ],
    [ "drop:2.l", "esp:GND.2", "black", [] ]
  ],
  "dependencies": {}
}
