{
  "name": "energy-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Home energy monitor backend: event-driven modular monolith (NestJS)",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "test": "jest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "metrics": "tsx scripts/metrics.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.11",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.11",
    "@nestjs/microservices": "^11.2.11",
    "@nestjs/platform-express": "^11.2.11",
    "@nestjs/platform-ws": "^11.2.11",
    "@nestjs/websockets": "^11.2.11",
    "ioredis": "^6.0.0",
    "mqtt": "^5.16.1",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.11",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["<rootDir>/test/**/*.test.ts"],
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "setupFiles": ["<rootDir>/test/setup.ts"]
  }
}
